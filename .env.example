# --- Lead magnet: doble opt-in propio + MailerLite como almacén ---

# Secreto para firmar los tokens de verificación (HMAC). Obligatorio en prod.
# Genéralo con: openssl rand -hex 32
LEAD_SECRET=

# Envío del email de verificación (Resend — https://resend.com).
RESEND_API_KEY=
# Remitente. Debe ser de un dominio verificado en Resend para enviar a todos.
RESEND_FROM="Fit con Aurena <hola@fitconaurena.com>"

# MailerLite: solo se usa para ALMACENAR los suscriptores ya confirmados
# (y desde ahí harás el email marketing / campañas).
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Carpeta de Google Drive con el contenido (pantalla /gracias).
NEXT_PUBLIC_GUIDE_URL=https://drive.google.com/drive/folders/TU_CARPETA

# Opcional: URL pública del sitio para construir los enlaces de confirmación.
NEXT_PUBLIC_SITE_URL=https://fitconaurena-web.vercel.app
