# --- Lead magnet (guía gratis con doble opt-in) ---

# Secreto para firmar los tokens de verificación (HMAC-SHA256).
# OBLIGATORIO en producción. Genera uno con: openssl rand -hex 32
LEAD_SECRET=

# Envío de email transaccional vía Resend (https://resend.com).
# Si no se define, el flujo funciona igual pero el email se registra en
# la consola del servidor en lugar de enviarse.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Fit con Aurena <hola@fitconaurena.com>"

# URL pública del sitio, usada para construir el enlace de verificación.
# Si no se define, se deduce del host de la petición.
NEXT_PUBLIC_SITE_URL=https://fitconaurena.com

# URL del PDF de la guía que se entrega tras verificar.
# Por defecto usa el archivo de muestra en /public.
NEXT_PUBLIC_GUIDE_URL=/guia-fit-con-aurena.pdf
