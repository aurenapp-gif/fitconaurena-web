# MailerLite API key — Integrations → Developer API in your MailerLite dashboard
MAILERLITE_API_KEY=

# ID of the MailerLite group where lead-magnet subscribers are added.
# Visible in the URL when you open the group in the dashboard.
MAILERLITE_GROUP_ID=

# Public Google Drive folder URL (link sharing on "anyone with the link").
# Shown on /lead-magnet/gracias after the user confirms their email.
NEXT_PUBLIC_DRIVE_FOLDER_URL=
