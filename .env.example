# ───────────────────────────────────────────────────────────────────────────
# Fit con Aurena — variables de entorno (NINGÚN valor real va en este archivo)
# Copia este archivo a .env.local (o config de Vercel) y rellena los valores.
# ───────────────────────────────────────────────────────────────────────────

# --- Lead magnet: doble opt-in propio + MailerLite como almacén ---

# Secreto para firmar los tokens de verificación del lead (HMAC). Obligatorio en prod.
# Genéralo con: openssl rand -hex 32
LEAD_SECRET=

# Envío de emails transaccionales (Resend — https://resend.com).
RESEND_API_KEY=
# Remitente. Debe ser de un dominio verificado en Resend para enviar a todos.
RESEND_FROM="Fit con Aurena <hola@fitconaurena.com>"

# MailerLite: almacén de suscriptores (lead magnet + miembros) y campañas.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Grupo del área de miembros (clientas con acceso).
MAILERLITE_MEMBERS_GROUP_ID=

# Carpeta de Google Drive con el contenido gratuito (pantalla /gracias).
NEXT_PUBLIC_GUIDE_URL=https://drive.google.com/drive/folders/TU_CARPETA

# URL pública del sitio (para construir enlaces de confirmación/acceso).
NEXT_PUBLIC_SITE_URL=https://fitconaurena.com

# --- Área de miembros ---

# Secreto para firmar el enlace mágico y la cookie de sesión (HMAC). Obligatorio en prod.
# Genéralo con: openssl rand -hex 32
MEMBERS_SECRET=

# Correos de administración (la coach). Separados por comas. Reciben avisos y ven el panel.
ADMIN_EMAILS=aurena@example.com

# URL de la sala de videollamada (botón "Acceder a la sala" / recordatorio del jueves).
NEXT_PUBLIC_CALL_URL=

# --- Supabase (PostgREST + Storage) — SOLO servidor ---
SUPABASE_URL=
# Clave secreta (service_role o secret key). Nunca exponer al cliente.
SUPABASE_SECRET_KEY=

# --- Cron (Vercel) ---
# Bearer que protege /api/cron. Genéralo con: openssl rand -hex 16
CRON_SECRET=

# --- Notificaciones Web Push (PWA) ---
# Genera el par con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY y NEXT_PUBLIC_VAPID_PUBLIC_KEY deben ser LA MISMA clave pública.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:aurenapp@gmail.com
