# --- Lead magnet (captación + doble opt-in vía MailerLite) ---

# Token de la API de MailerLite (Integrations → API).
# OBLIGATORIO para que el formulario dé de alta suscriptores.
MAILERLITE_API_KEY=

# ID del grupo de MailerLite donde se añaden los suscriptores
# (recomendado: permite lanzar automatizaciones sobre ese grupo).
MAILERLITE_GROUP_ID=

# URL pública del contenido en Google Drive (carpeta o archivo) que se
# muestra en la pantalla /gracias tras verificar el correo.
NEXT_PUBLIC_GUIDE_URL=https://drive.google.com/drive/folders/TU_CARPETA

# IMPORTANTE: en MailerLite activa "Double opt-in for API and integrations"
# (Settings → Subscribe settings) para que se envíe el email de confirmación.
# Y configura la redirección tras confirmar hacia:  https://fitconaurena.com/gracias
